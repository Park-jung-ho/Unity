      m_Calls: []
  m_text: "\uC5B4\uC11C \uC624\uC138\uC694! \uC2E0\uC120\uD558\uACE0 \uB9DB\uC788\uB294
    \uACFC\uC77C, \uC5EC\uAE30 \uB2E4 \uBAA8\uC5EC\uC788\uC9C0! \uC774 \uACFC\uC77C\uB4E4\uC740
    \uB2E8\uC21C\uD55C \uBA39\uAC70\uB9AC\uAC00 \uC544\uB2C8\uC57C. \uC774 \uACFC\uC77C\uC740
    \uAC89\uBCF4\uAE30\uC640\uB294 \uB2EC\uB77C. \uD2B9\uBCC4\uD55C \uD798\uC744
    \uAC00\uC9C0\uACE0 \uC788\uC9C0. \uC790\uC138\uD788 \uBD10... \uC774 \uC0AC\uACFC\uC5D0\uC11C
    \uB098\uB294 \uD76C\uBBF8\uD55C \uBE5B\uC774 \uBCF4\uC774\uC9C0 \uC54A\uB098?
    \uC5B4\uCA4C\uBA74 \uB124 \uC5EC\uC815\uC5D0 \uD070 \uB3C4\uC6C0\uC774 \uB420
    \uC218\uB3C4 \uC788\uC9C0. \uC120\uD0DD\uC740 \uB108\uC758 \uBAAB\uC774\uB2E4.
    \uC5B4\uB5A4 \uACFC\uC77C\uC774 \uB108\uC758 \uC6B4\uBA85\uC744 \uBC14\uAFC0\uC9C0... 
    \uB0B4\uAC00 \uD30C\uB294 \uAC74 \uACFC\uC77C\uB9CC\uC774 \uC544\uB2C8\uC57C.
    \uAD81\uAE08\uD558\uB2E4\uBA74, \uB2E4\uC74C\uC5D0 \uB2E4\uC2DC \uCC3E\uC544\uC624\uB834."
